rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /quizResults/{resultId} {

      allow create:
        if request.auth != null &&
           request.resource.data.userId == request.auth.uid;

      allow read:
        if request.auth != null;

      allow update, delete:
        if false;
    }
  }
}